# frozen_string_literal: true

# -*- mode: ruby -*-
# vi: set ft=ruby :

require 'yaml'

BOXES = YAML.load_file(File.join(__dir__, 'boxes.yaml'))

Vagrant.configure('2') do |config|
  config.vm.synced_folder '.', '/vagrant', type: 'virtualbox'
  config.vm.boot_timeout = 600

  BOXES.each do |name, opts|
    config.vm.define name do |vm|
      vm.vm.box = opts['box']
      vm.vm.box_version = opts['box_version'] unless opts['box_version'].to_s.empty?
      vm.vm.network 'public_network'
      vm.vm.network 'forwarded_port', guest: 22, host: 2222, id: 'ssh', auto_correct: true
      vm.vm.disk :disk, size: '40GB', primary: true

      vm.vm.provider 'virtualbox' do |vb|
        vb.memory = '4096'
        vb.cpus = 2
      end

      env_vars = {
        'BOX_NAME' => name.to_s,
        'PKG_UPDATE' => opts['pkg_update'].to_s,
        'PKG_INSTALL' => opts['pkg_install'].to_s,
        'DEVEL_PKGS' => opts['devel_pkgs'].to_s,
        'SUDO_GROUP' => opts['sudo_group'].to_s,
        'EXTRA_PKGS' => opts['extra_pkgs'].to_s,
        'ROUTINATOR_VERSION' => opts['routinator_version'].to_s,
        'FORT_BUILD_FROM_SOURCE' => opts['fort_build_from_source'].to_s,
        'FORT_VERSION' => opts['fort_version'].to_s
      }

      vm.vm.provision 'shell', path: 'provision-user.sh', env: env_vars
      vm.vm.provision 'shell', path: 'provision-root.sh', privileged: true, env: env_vars

      vm.vm.provision 'shell', privileged: false, inline: <<-SHELL
        echo "routinator: $(command -v routinator || echo missing) $(routinator -V 2>/dev/null || true)"
        echo "fort: $(command -v fort || echo missing) $(fort -V 2>/dev/null || true)"
        echo "vuls: $(command -v vuls || echo missing)"
      SHELL
    end
  end
end
